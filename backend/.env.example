# Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname> or sqlite:///./threat_intel.db
DATABASE_URL=postgresql://postgres:postgres@db:5432/threat_intel

# Frontend URL for CORS (use * for all origins in development)
FRONTEND_URL=http://localhost:80

# API Keys for Production & Live Threat Integrations
IPINFO_TOKEN=your_ipinfo_token_here
IP_API_KEY=your_ipgeolocation_api_key_here
IPGEOLOCATION_API_KEY=your_ipgeolocation_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
